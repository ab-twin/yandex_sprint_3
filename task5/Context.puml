@startuml
title Контекстная диаграмма — Онлайн-заявка на кредит

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml

Person(customer, "Клиент", "Новый или существующий пользователь")

System(site, "Сайт", "Канал подачи заявки для новых клиентов")
System(ibank, "Интернет-банк", "Канал подачи заявки для действующих клиентов")
System(api, "Кредитный API", "Обрабатывает заявки на кредит")
System(scoring, "Скоринг-система", "Оценивает платёжеспособность клиента")
System(bki, "Бюро кредитных историй", "Источник кредитной истории клиента")
System(abs, "АБС", "Основная банковская система. Хранит заявки")
System(cc, "Кредитный конвейер", "Обработка заявок сотрудниками")
System(sms, "СМС-шлюз", "Информирует клиента о статусе заявки")

Rel(customer, site, "Подаёт заявку")
Rel(customer, ibank, "Подаёт заявку по предодобренному предложению")

Rel(site, api, "Передаёт заявку")
Rel(ibank, api, "Передаёт заявку")

Rel(api, scoring, "Выполняет скоринг", "REST API")
Rel(scoring, bki, "Запрашивает данные", "REST API")
Rel(api, abs, "Передаёт в АБС", "Асинхронно (Kafka)")
Rel(abs, cc, "Синхронизирует заявки")
Rel(api, sms, "Оповещает клиента", "HTTP API")

@enduml
